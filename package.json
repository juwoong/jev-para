{
  "name": "jev-para",
  "version": "0.3.2",
  "private": true,
  "description": "Jev PARA: Inbox notes sorted into PARA folders with the Jev decision API.",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "install:testing": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
